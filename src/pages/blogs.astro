---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/nav.astro';
import blogData from '../data/blogs.json';
import localData from '../data/home.json';
import { getBlogPosts } from '../lib/blogs';

const { page, postLinkLabel } = blogData;
const posts = getBlogPosts();
const pageTitle = page.titleTemplate.replace('{name}', localData.name);

function formatDate(date: string) {
  return new Intl.DateTimeFormat('en', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  }).format(new Date(date));
}
---

<Layout title={pageTitle}>
  <Nav />
  <section class="blogs-page section-container">
    <div class="blogs-heading">
      <p>{page.eyebrow}</p>
      <h1>{page.title}</h1>
      <span>{page.description}</span>
    </div>

    <div class="blog-timeline">
      <div class="timeline-line"></div>

      {posts.map((post, index) => (
        <article class="timeline-item">
          <div class="timeline-dot">
            <span class={index === 0 ? 'current' : ''}></span>
          </div>

          <a href={`/blogs/${post.slug}/`} class="timeline-card">
            <div class="post-meta">
              <span>{post.category}</span>
              <time datetime={post.date}>{formatDate(post.date)}</time>
            </div>
            <h2>{post.title}</h2>
            <p>{post.excerpt}</p>
            <footer>
              <span>{post.readTime}</span>
              <strong>{postLinkLabel}</strong>
            </footer>
          </a>
        </article>
      ))}
    </div>
  </section>
</Layout>

<style>
  .blogs-page {
    min-height: 100vh;
    padding-top: 4.5rem;
  }

  .blogs-heading {
    max-width: 48rem;
    margin-bottom: 3rem;
  }

  .blogs-heading p {
    color: var(--color-accent);
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    margin-top: 0.75rem;
    color: var(--color-maintext);
    font-family: var(--font-heading);
    font-size: 3rem;
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: 0;
  }

  .blogs-heading span {
    display: block;
    margin-top: 1rem;
    color: var(--color-subtext);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .blog-timeline {
    position: relative;
    max-width: 74rem;
    margin: 0 auto;
  }

  .timeline-line {
    position: absolute;
    top: 1.25rem;
    bottom: 0;
    left: 1rem;
    width: 2px;
    background: linear-gradient(to bottom, var(--color-accent), color-mix(in srgb, var(--color-maintext) 10%, transparent), transparent);
  }

  .timeline-item {
    position: relative;
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .timeline-dot {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: center;
    padding-top: 1.1rem;
  }

  .timeline-dot span {
    width: 1rem;
    height: 1rem;
    border: 4px solid #050914;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent) 55%, transparent);
  }

  .timeline-dot .current {
    background: var(--color-accent);
    box-shadow: 0 0 18px color-mix(in srgb, var(--color-accent) 80%, transparent);
  }

  .timeline-card {
    display: block;
    border: 1px solid color-mix(in srgb, var(--color-maintext) 10%, transparent);
    border-radius: 0.55rem;
    background: color-mix(in srgb, var(--color-panel) 72%, transparent);
    padding: clamp(1.1rem, 3vw, 1.6rem);
    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      background 0.25s ease;
  }

  .timeline-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--color-accent) 42%, transparent);
    background: color-mix(in srgb, var(--color-panel) 88%, transparent);
  }

  .post-meta,
  footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    align-items: center;
    justify-content: space-between;
    color: var(--color-muted);
    font-size: 0.8rem;
  }

  .post-meta span {
    color: var(--color-accent);
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    margin-top: 0.8rem;
    color: var(--color-maintext);
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 850;
    letter-spacing: 0;
  }

  .timeline-card p {
    max-width: 58rem;
    margin-top: 0.75rem;
    color: var(--color-subtext);
    line-height: 1.75;
  }

  footer {
    margin-top: 1rem;
  }

  footer strong {
    color: var(--color-accent);
    font-weight: 850;
  }
</style>
