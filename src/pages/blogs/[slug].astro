---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/nav.astro';
import blogData from '../../data/blogs.json';
import localData from '../../data/home.json';
import { getBlogPosts } from '../../lib/blogs';

export function getStaticPaths() {
  return getBlogPosts().map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = post;
const pageTitle = `${post.title} | ${localData.name}`;

function formatDate(date: string) {
  return new Intl.DateTimeFormat('en', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  }).format(new Date(date));
}
---

<Layout title={pageTitle}>
  <Nav />
  <article class="blog-post section-container">
    <a href={blogData.recent.moreHref} class="back-link">{blogData.page.title}</a>

    <header>
      <div class="post-meta">
        <span>{post.category}</span>
        <time datetime={post.date}>{formatDate(post.date)}</time>
        <em>{post.readTime}</em>
      </div>
      <h1>{post.title}</h1>
      <p>{post.excerpt}</p>
    </header>

    <div class="post-content">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .blog-post {
    min-height: 100vh;
    max-width: 58rem;
    padding-top: 8.5rem;
  }

  .back-link {
    display: inline-flex;
    margin-bottom: 2rem;
    color: var(--color-accent);
    font-weight: 850;
  }

  header {
    border-bottom: 1px solid color-mix(in srgb, var(--color-maintext) 10%, transparent);
    padding-bottom: 2rem;
    margin-bottom: 2rem;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    color: var(--color-muted);
    font-size: 0.84rem;
  }

  .post-meta span {
    color: var(--color-accent);
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .post-meta em {
    font-style: normal;
  }

  h1 {
    margin-top: 1rem;
    color: var(--color-maintext);
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 7vw, 4.8rem);
    font-weight: 900;
    line-height: 0.98;
    letter-spacing: 0;
  }

  header p {
    margin-top: 1rem;
    color: var(--color-subtext);
    font-size: 1.08rem;
    line-height: 1.75;
  }

  .post-content {
    color: var(--color-subtext);
    font-size: 1.02rem;
    line-height: 1.85;
  }

  .post-content :global(p) {
    margin: 1.1rem 0;
  }

  .post-content :global(h2),
  .post-content :global(h3) {
    margin: 2rem 0 0.75rem;
    color: var(--color-maintext);
    font-family: var(--font-heading);
    letter-spacing: 0;
  }

  .post-content :global(img) {
    width: 100%;
    border: 1px solid color-mix(in srgb, var(--color-maintext) 10%, transparent);
    border-radius: 0.55rem;
    margin: 1.5rem 0;
  }
</style>
