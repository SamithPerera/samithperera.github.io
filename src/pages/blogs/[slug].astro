---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/nav.astro';
import blogData from '../../data/blogs.json';
import localData from '../../data/home.json';
import { getBlogPosts } from '../../lib/blogs';

export function getStaticPaths() {
  return getBlogPosts().map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = post;
const pageTitle = `${post.title} | ${localData.name}`;

function formatDate(date: string) {
  return new Intl.DateTimeFormat('en', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  }).format(new Date(date));
}
---

<Layout title={pageTitle}>
  <Nav />
  <article class="blog-post section-container">
    <div class="post-header-wrapper">
      <a href={blogData.recent.moreHref} class="back-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        {blogData.page.title}
      </a>

      <header>
        <div class="post-meta">
          <span class="category">{post.category}</span>
          <span class="separator">•</span>
          <time datetime={post.date}>{formatDate(post.date)}</time>
          <span class="separator">•</span>
          <em>{post.readTime}</em>
        </div>
        <h1>{post.title}</h1>
        {post.excerpt && post.excerpt !== post.title && <p class="excerpt">{post.excerpt}</p>}
      </header>
    </div>

    <div class="post-content">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .blog-post {
    min-height: 100vh;
    max-width: 52rem;
    padding-top: 8.5rem;
    margin: 0 auto;
  }

  .post-header-wrapper {
    margin-bottom: 3.5rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 2.5rem;
    color: var(--color-accent);
    font-weight: 850;
    font-size: 0.95rem;
    transition: transform 0.2s ease;
  }

  .back-link:hover {
    transform: translateX(-4px);
  }

  header {
    position: relative;
  }

  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.8rem;
    color: var(--color-muted);
    font-size: 0.88rem;
    margin-bottom: 1.2rem;
  }

  .post-meta .category {
    color: var(--color-accent);
    font-weight: 900;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .post-meta .separator {
    opacity: 0.4;
  }

  .post-meta em {
    font-style: normal;
  }

  h1 {
    color: var(--color-maintext);
    font-family: var(--font-heading);
    font-size: clamp(3rem, 4.8vw, 3.25rem);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .excerpt {
    margin-top: 1.5rem;
    color: var(--color-subtext);
    font-size: 1.2rem;
    line-height: 1.6;
    font-weight: 500;
    opacity: 0.9;
  }

  .post-content {
    color: var(--color-subtext);
    font-size: 1.125rem;
    line-height: 1.8;
  }

  .post-content :global(p) {
    margin: 1.5rem 0;
  }

  .post-content :global(h2) {
    font-size: 1.5rem;
    margin: 3rem 0 1.2rem;
    color: var(--color-maintext);
    font-family: var(--font-heading);
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .post-content :global(h3) {
    font-size: 1.4rem;
    margin: 2.5rem 0 1rem;
    color: var(--color-maintext);
    font-family: var(--font-heading);
    font-weight: 700;
  }

  .post-content :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid color-mix(in srgb, var(--color-maintext) 15%, transparent);
    border-radius: 0.75rem;
    margin: 2.5rem 0;
    box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.5);
  }

  .post-content :global(hr) {
    border: 0;
    border-top: 1px solid color-mix(in srgb, var(--color-maintext) 10%, transparent);
    margin: 3rem 0;
  }

  .post-content :global(ul), 
  .post-content :global(ol) {
    margin: 1.5rem 0 1.5rem 1.25rem;
    padding-left: 1.25rem;
    color: var(--color-subtext);
  }

  .post-content :global(li) {
    margin: 0.75rem 0;
    padding-left: 0.35rem;
  }

  .post-content :global(li::marker) {
    color: var(--color-accent);
    font-weight: 800;
  }

  .post-content :global(ol) {
    list-style: decimal;
  }

  .post-content :global(ul) {
    list-style: disc;
  }

  .post-content :global(ul ul),
  .post-content :global(ol ol),
  .post-content :global(ul ol),
  .post-content :global(ol ul) {
    margin: 0.6rem 0 0.6rem 1rem;
  }

  .post-content :global(li > p) {
    margin: 0.35rem 0;
  }

  .post-content :global(code) {
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    color: var(--color-accent);
    padding: 0.2rem 0.4rem;
    border-radius: 0.3rem;
    font-size: 0.9em;
  }

  .post-content :global(pre) {
    padding: 1.5rem;
    border-radius: 0.75rem;
    margin: 2rem 0;
    background: #0d1117 !important;
    border: 1px solid color-mix(in srgb, var(--color-maintext) 10%, transparent);
    overflow-x: auto;
  }

  .post-content :global(pre code) {
    background: transparent;
    color: inherit;
    padding: 0;
    border-radius: 0;
    font-size: 0.95rem;
  }

  .post-content :global(blockquote) {
    margin: 2rem 0;
    padding: 0.5rem 1.5rem;
    border-left: 4px solid var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 5%, transparent);
    border-radius: 0 0.5rem 0.5rem 0;
    font-style: italic;
  }

  .post-content :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
    text-decoration-color: color-mix(in srgb, var(--color-accent) 30%, transparent);
    transition: text-decoration-color 0.2s ease;
  }

  .post-content :global(a:hover) {
    text-decoration-color: var(--color-accent);
  }

  .post-content :global(table) {
    width: 100%;
    margin: 2rem 0;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .post-content :global(th) {
    text-align: left;
    padding: 0.75rem;
    border-bottom: 2px solid color-mix(in srgb, var(--color-maintext) 15%, transparent);
    color: var(--color-maintext);
    font-weight: 700;
  }

  .post-content :global(td) {
    padding: 0.75rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-maintext) 10%, transparent);
  }

  @media (max-width: 768px) {
    .blog-post {
      padding-top: 6rem;
    }
    
    h1 {
      font-size: 3rem;
    }
  }
</style>
