---
import { Icon } from 'astro-icon/components';
import certificationsData from '../data/certifications.json';

type CertType = 'certification' | 'professional-development' | 'in-progress';

const { section, items } = certificationsData;

function badgeClass(type: CertType) {
  if (type === 'professional-development') return 'badge-pro-dev';
  if (type === 'in-progress') return 'badge-in-progress';
  return 'badge-earned';
}

function cardModClass(type: CertType) {
  if (type === 'in-progress') return 'cert-in-progress';
  if (type === 'professional-development') return 'cert-pro-dev';
  return '';
}

function legendDotClass(type: string) {
  if (type === 'professional-development') return 'dot-pro-dev';
  if (type === 'in-progress') return 'dot-in-progress';
  return 'dot-earned';
}
---

<section id="certifications" class="section-container certifications-section">
  <div class="cert-header reveal">
    <p>{section.eyebrow}</p>
    <h2><span>{section.marker}</span> {section.title}</h2>
    <small>{section.description}</small>

    <div class="legend-row">
      {section.legend.map((legend) => (
        <span class="legend-item">
          <span class={`legend-dot ${legendDotClass(legend.type)}`}></span>
          {legend.label}
        </span>
      ))}
    </div>
  </div>

  <div class="cert-grid">
    {items.map((cert, index) => {
      const type = (cert.type ?? 'certification') as CertType;

      return (
        <article class={`cert-card reveal ${cardModClass(type)}`} style={`transition-delay: ${(index % 2) * 0.08}s;`}>
          <div class="cert-top">
            <h3>{cert.name}</h3>
            <div class="cert-status-group">
              {cert.validity && (
                <span
                  class={`validity-dot validity-${cert.validity.state}`}
                  aria-label={`${section.labels.validityLabel}: ${cert.validity.tooltip}`}
                  data-tooltip={cert.validity.tooltip}
                  tabindex="0"
                ></span>
              )}
              <span class={`cert-badge ${badgeClass(type)}`}>
                {type === 'in-progress' && <span class="badge-pulse-dot" />}
                {cert.status}
              </span>
            </div>
          </div>

          <p class={`issuer issuer-${type}`}>
            {cert.issuer}
            {type === 'professional-development' && <span>{section.labels.courseTag}</span>}
          </p>

          <p class="description">{cert.description}</p>

          <footer>
            <span>{cert.date}</span>

            {type === 'in-progress' ? (
              <strong class="in-progress-label">
                <span></span>
                {section.labels.inProgress}
              </strong>
            ) : cert.credentialUrl ? (
              <a href={cert.credentialUrl} target="_blank" rel="noopener noreferrer">
                {type === 'professional-development' ? section.labels.viewCertificate : section.labels.viewCredential}
                <Icon name="mdi:arrow-top-right" class="h-4 w-4" />
              </a>
            ) : (
              <em>{section.labels.noLink}</em>
            )}
          </footer>
        </article>
      );
    })}
  </div>
</section>

<script>
  document.querySelectorAll('#certifications .reveal').forEach((el) => {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          el.classList.add('visible');
          observer.disconnect();
        }
      },
      { threshold: 0.08 }
    );

    observer.observe(el);
  });
</script>

<style>
  .certifications-section {
    overflow: hidden;
  }

  .cert-header {
    max-width: 58rem;
    margin: 0 auto 2.5rem;
    text-align: center;
  }

  .cert-header p {
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .cert-header h2 {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    margin-top: 0.75rem;
    color: var(--color-maintext);
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 5vw, 3.4rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0;
  }

  .cert-header h2 span {
    color: var(--color-accent);
  }

  .cert-header small {
    display: block;
    max-width: 42rem;
    margin: 0.85rem auto 0;
    color: var(--color-subtext);
    font-size: 0.98rem;
    line-height: 1.7;
  }

  .legend-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.8rem 1.35rem;
    margin-top: 1.3rem;
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-muted);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .legend-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
  }

  .dot-earned {
    background: #34d399;
  }

  .dot-pro-dev {
    background: #f59e0b;
  }

  .dot-in-progress {
    background: #60a5fa;
    box-shadow: 0 0 8px rgba(96, 165, 250, 0.68);
  }

  .cert-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    max-width: 72rem;
    margin: 0 auto;
  }

  .cert-card {
    display: flex;
    min-height: 16rem;
    flex-direction: column;
    border: 1px solid color-mix(in srgb, var(--color-maintext) 10%, transparent);
    border-radius: 0.55rem;
    background: color-mix(in srgb, var(--color-panel) 72%, transparent);
    padding: 1.15rem;
    transition:
      opacity 0.55s ease,
      transform 0.55s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .cert-card:hover {
    border-color: color-mix(in srgb, var(--color-accent) 42%, transparent);
    box-shadow: 0 18px 50px color-mix(in srgb, black 22%, transparent);
  }

  .cert-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .cert-status-group {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.55rem;
  }

  .validity-dot {
    position: relative;
    width: 0.68rem;
    height: 0.68rem;
    border-radius: 999px;
    box-shadow: 0 0 0 3px color-mix(in srgb, currentColor 13%, transparent);
  }

  .validity-active {
    color: #34d399;
    background: #34d399;
  }

  .validity-expired {
    color: #ef4444;
    background: #ef4444;
  }

  .validity-dot::after {
    content: attr(data-tooltip);
    position: absolute;
    right: 50%;
    bottom: calc(100% + 0.65rem);
    z-index: 5;
    width: max-content;
    max-width: 12rem;
    transform: translateX(50%) translateY(0.25rem);
    border: 1px solid color-mix(in srgb, var(--color-maintext) 12%, transparent);
    border-radius: 0.4rem;
    background: #050914;
    color: var(--color-maintext);
    box-shadow: 0 16px 42px color-mix(in srgb, black 28%, transparent);
    padding: 0.45rem 0.6rem;
    font-size: 0.72rem;
    font-weight: 800;
    line-height: 1.25;
    opacity: 0;
    pointer-events: none;
    text-align: center;
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
  }

  .validity-dot:hover::after,
  .validity-dot:focus-visible::after {
    opacity: 1;
    transform: translateX(50%) translateY(0);
  }

  h3 {
    color: var(--color-maintext);
    font-family: var(--font-heading);
    font-size: 1.12rem;
    font-weight: 850;
    line-height: 1.24;
    letter-spacing: 0;
  }

  .cert-badge {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid;
    border-radius: 999px;
    padding: 0.24rem 0.62rem;
    font-size: 0.72rem;
    font-weight: 800;
    white-space: nowrap;
  }

  .badge-earned {
    border-color: rgba(16, 185, 129, 0.26);
    background: rgba(16, 185, 129, 0.12);
    color: #6ee7b7;
  }

  .badge-pro-dev {
    border-color: rgba(245, 158, 11, 0.26);
    background: rgba(245, 158, 11, 0.12);
    color: #fcd34d;
  }

  .badge-in-progress {
    border-color: rgba(96, 165, 250, 0.3);
    background: rgba(96, 165, 250, 0.12);
    color: #93c5fd;
  }

  .badge-pulse-dot,
  .in-progress-label span {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: #60a5fa;
    animation: pulseDot 1.6s ease-in-out infinite;
  }

  .issuer {
    margin-top: 0.75rem;
    color: var(--color-accent);
    font-size: 0.74rem;
    font-weight: 900;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .issuer-professional-development {
    color: #f59e0b;
  }

  .issuer-in-progress {
    color: #60a5fa;
  }

  .issuer span {
    display: inline-block;
    margin-left: 0.45rem;
    border: 1px solid rgba(245, 158, 11, 0.24);
    border-radius: 0.3rem;
    background: rgba(245, 158, 11, 0.1);
    color: #fbbf24;
    padding: 0.08rem 0.38rem;
    font-size: 0.62rem;
  }

  .description {
    margin-top: 0.85rem;
    color: var(--color-subtext);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--color-maintext) 8%, transparent);
  }

  footer > span {
    color: var(--color-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.78rem;
  }

  footer a,
  footer em,
  .in-progress-label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: color-mix(in srgb, var(--color-accent) 78%, var(--color-maintext));
    font-size: 0.78rem;
    font-style: normal;
    font-weight: 800;
  }

  footer em {
    color: var(--color-muted);
    font-weight: 600;
  }

  .cert-pro-dev {
    border-color: rgba(245, 158, 11, 0.14);
  }

  .cert-pro-dev:hover {
    border-color: rgba(245, 158, 11, 0.36);
  }

  .cert-in-progress {
    border-style: dashed;
    border-color: rgba(96, 165, 250, 0.35);
  }

  .cert-in-progress:hover {
    border-color: rgba(96, 165, 250, 0.62);
  }

  .reveal {
    opacity: 0;
    transform: translateY(1.2rem);
  }

  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  @keyframes pulseDot {
    50% {
      opacity: 0.45;
      transform: scale(0.75);
    }
  }

  @media (max-width: 860px) {
    .cert-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .cert-top,
    footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
