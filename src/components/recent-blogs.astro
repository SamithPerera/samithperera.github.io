---
import { Icon } from 'astro-icon/components';
import blogData from '../data/blogs.json';
import { getBlogPosts } from '../lib/blogs';

const { recent } = blogData;
const posts = getBlogPosts();
const recentBlogs = posts.slice(0, recent.limit);

function formatDate(date: string) {
  return new Intl.DateTimeFormat('en', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  }).format(new Date(date));
}
---

<section id="blogs" class="section-container recent-blogs">
  <div class="section-heading">
    <div>
      <h2><span>{recent.marker}</span> {recent.title}</h2>
      <p>{recent.description}</p>
    </div>
    <a href={recent.moreHref} class="more-link">
      <span>{recent.moreLabel}</span>
      <Icon name={recent.moreIcon} class="h-5 w-5" />
    </a>
  </div>

  <div class="blog-grid">
    {recentBlogs.map((post) => (
      <a href={`/blogs/${post.slug}/`} class="blog-card">
        <div class="blog-meta">
          <span>{post.category}</span>
          <time datetime={post.date}>{formatDate(post.date)}</time>
        </div>
        <h3>{post.title}</h3>
        <p>{post.excerpt}</p>
        <div class="blog-footer">
          <span>{post.readTime}</span>
          <Icon name={recent.cardIcon} class="h-5 w-5" />
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .recent-blogs {
    overflow: hidden;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  h2 {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: var(--color-maintext);
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0;
  }

  h2 span {
    color: var(--color-accent);
  }

  .section-heading p {
    max-width: 34rem;
    margin-top: 0.75rem;
    color: var(--color-subtext);
    line-height: 1.65;
  }

  .more-link {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 34%, transparent);
    border-radius: 0.5rem;
    color: var(--color-maintext);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    padding: 0 1rem;
    font-weight: 800;
    white-space: nowrap;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .more-link:hover {
    transform: translateY(-2px);
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 16%, transparent);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .blog-card {
    min-height: 17rem;
    display: flex;
    flex-direction: column;
    border: 1px solid color-mix(in srgb, var(--color-maintext) 10%, transparent);
    border-radius: 0.55rem;
    background: color-mix(in srgb, var(--color-panel) 72%, transparent);
    padding: 1.2rem;
    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      background 0.25s ease;
  }

  .blog-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--color-accent) 42%, transparent);
    background: color-mix(in srgb, var(--color-panel) 88%, transparent);
  }

  .blog-meta,
  .blog-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--color-muted);
    font-size: 0.78rem;
  }

  .blog-meta span {
    color: var(--color-accent);
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h3 {
    margin-top: 1rem;
    color: var(--color-maintext);
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0;
  }

  .blog-card p {
    margin-top: 0.75rem;
    color: var(--color-subtext);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .blog-footer {
    margin-top: auto;
    padding-top: 1.2rem;
    color: color-mix(in srgb, var(--color-subtext) 82%, transparent);
  }

  @media (max-width: 900px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .section-heading {
      align-items: start;
      flex-direction: column;
    }
  }
</style>
