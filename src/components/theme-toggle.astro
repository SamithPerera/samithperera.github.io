---
import { Icon } from 'astro-icon/components';
import site from '../data/site.json';
---

<button id="theme-toggle" type="button" aria-label={site.ui.themeToggleLabel} title={site.ui.themeToggleTitle}>
  <Icon name="mdi:white-balance-sunny" class="sun-icon h-5 w-5" />
  <Icon name="mdi:moon-waning-crescent" class="moon-icon h-5 w-5" />
</button>

<style>
  #theme-toggle {
    width: 2.45rem;
    height: 2.45rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.55rem;
    border: 1px solid color-mix(in srgb, var(--color-maintext) 12%, transparent);
    color: var(--color-maintext);
    background: color-mix(in srgb, var(--color-panel) 74%, transparent);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  #theme-toggle:hover {
    transform: translateY(-1px);
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
  }

  :global([data-theme$="-dark"]) .sun-icon {
    display: none;
  }

  :global([data-theme$="-light"]) .moon-icon {
    display: none;
  }
</style>

<script>
  const themeToggle = document.getElementById('theme-toggle');

  themeToggle?.addEventListener('click', () => {
    const currentTheme = document.documentElement.getAttribute('data-theme') || 'samith-dark';
    const isDark = currentTheme.endsWith('-dark');
    const newTheme = isDark ? currentTheme.replace('-dark', '-light') : currentTheme.replace('-light', '-dark');

    document.documentElement.setAttribute('data-theme', newTheme);
    localStorage.setItem('theme', newTheme);
  });
</script>
